ORDERS_IMAGE=usuario2/tienda-orders-service:1.0
CUSTOMERS_IMAGE=usuario3/tienda-customers-service:1.0
GATEWAY_IMAGE=usuario4/tienda-api-gateway:1.0
FRONTEND_IMAGE=usuario4/tienda-frontend:1.0
