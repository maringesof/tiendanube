# orders-service (Oracle Autonomous Database). Copie como .env y complete.
PORT=8002
ORACLE_USER=USUARIO
ORACLE_PASSWORD=CLAVE
# Cadena TLS de OCI (Autonomous DB > Database connection > TLS)
ORACLE_CONNECT_STRING=(description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1521)(host=HOST))(connect_data=(service_name=SERVICIO_low.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
# Nombre del contenedor de productos dentro de la red Docker
PRODUCTS_SERVICE_URL=http://products-service:8001
